#!/bin/sh
set -eu
cd "$(dirname "$0")/.."
test "$(go env GOOS)" = darwin
package=build/install/scryer-go-engine
mkdir -p "$package/bin"
CGO_ENABLED=1 go build -trimpath -buildmode=c-shared -o "$package/bin/libscryer-go-engine.dylib" ./cmd/go-engine-abi
rm -f "$package/bin/libscryer-go-engine.h"
cat > "$package/engine.json" <<MANIFEST
{
  "schemaVersion": 1,
  "engine": {
    "protocolVersion": 1,
    "id": "go",
    "name": "Scryer Go Engine",
    "version": "0.0.0-dev",
    "source": "github.com/scryer-labs/scryer-go-engine",
    "mock": false
  },
  "capabilities": {
    "languages": ["Go"],
    "operations": ["scan"],
    "scanFacts": ["dependencies"]
  },
  "library": "bin/libscryer-go-engine.dylib",
  "os": "darwin",
  "arch": "$(go env GOARCH)"
}
MANIFEST
cp LICENSE "$package/"
